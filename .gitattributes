# Default to auto (Git decides based on content)
* text=auto eol=lf

# Force LF for scripts and source files
*.sh text eol=lf
*.bash text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force CRLF for Windows-specific files (if any exist)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Build output — generated by `npm run build`, committed only so marketplace/
# clone installs work. Mark generated (collapse in PR diffs) and -diff (suppress
# the large textual diffs locally and in review).
dist/** linguist-generated=true -diff
bridge/** linguist-generated=true -diff

# Binary files (no conversion)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
